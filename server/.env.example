# Server
NODE_ENV=development
PORT=5000

# Database
MONGODB_URI=mongodb://localhost:27017/hustlr

# JWT
JWT_SECRET=your-jwt-secret-here
JWT_EXPIRES_IN=7d

# CORS
CLIENT_ORIGINS=http://localhost:3000,http://lvh.me:3000,http://localhost:3001
ADMIN_WEBSITE_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000
PLATFORM_DOMAIN=hustlr.shop
DEV_PLATFORM_DOMAIN=lvh.me
COOKIE_DOMAIN=.lvh.me

# Cloudflare R2 (S3-compatible)
AWS_REGION=auto
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=hustlr-uploads
R2_PUBLIC_URL=https://pub-xxxxx.r2.dev

# Email (Resend - primary)
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=Hustlr <noreply@hustlr.shop>

# Email (SMTP - fallback)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Firebase (Google OAuth)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Paystack
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxx

# AI — SpaceXAI / xAI (preferred)
XAI_API_KEY=
XAI_MODEL=grok-4.5
XAI_BASE_URL=https://api.x.ai/v1

# AI (DeepSeek or compatible LLM — fallback)
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxx
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Custom domain verification (optional apex A-record target)
PLATFORM_SERVER_IP=
CUSTOM_DOMAIN_CNAME_TARGET=stores.hustlr.shop
