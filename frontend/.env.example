# Transport mode: "mock" (local fixtures) | "api" (Express backend)
NEXT_PUBLIC_TRANSPORT=mock

# Express backend API base URL (used when NEXT_PUBLIC_TRANSPORT=api)
NEXT_PUBLIC_API_URL=http://api.lvh.me:5000/api

# Platform root domain (subdomain storefronts resolve against this)
NEXT_PUBLIC_PLATFORM_DOMAIN=hustlr.online

# Local dev domain for realistic subdomain testing (e.g. {slug}.lvh.me:3000)
NEXT_PUBLIC_DEV_DOMAIN=lvh.me

# Cloudflare R2 public URL (uploaded store/product images)
NEXT_PUBLIC_R2_PUBLIC_URL=https://pub-xxxxx.r2.dev

# Google OAuth client ID (seller/buyer "Continue with Google")
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
